# Environment configuration for BUKZ Accounting
# Copy this file to .env.local and fill in the missing values

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"

# Database (self-hosted PostgreSQL)
DATABASE_URL="postgresql://bukz:bukz_dev_password@localhost:5432/bukz_db"

# Auth.js
# Generate with: npx auth secret
AUTH_SECRET="generate-with-npx-auth-secret"
# Required when self-hosting behind a reverse proxy (not Vercel) — tells Auth.js to trust
# the proxy's forwarded host, or auth requests fail with an UntrustedHost error.
AUTH_TRUST_HOST=true

# Stripe Payments
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Transactional email (Resend) — required for account verification, password reset,
# and notification emails. Without these, users cannot verify their account or reset
# their password via email (an admin can still verify a user manually from /admin/users).
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="BUKZ <noreply@yourdomain.com>"

# AWS S3 Storage (CV uploads, avatars)
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="eu-west-2"
AWS_S3_BUCKET="bukz-uploads"
# CLOUDFRONT_DOMAIN="d123456.cloudfront.net"

# Algolia Search
NEXT_PUBLIC_ALGOLIA_APP_ID="..."
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY="..."
ALGOLIA_ADMIN_KEY="..."

# PostHog Analytics (optional — features degrade gracefully if unset)
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://eu.posthog.com"
POSTHOG_API_KEY="phc_..."
POSTHOG_HOST="https://eu.posthog.com"

# AI features (skills-gap analysis)
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."

# Cal.com (expert booking)
CAL_API_KEY="cal_..."

# Sentry
SENTRY_DSN="..."
NEXT_PUBLIC_SENTRY_DSN="..."
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="bukz-accounting"
SENTRY_AUTH_TOKEN="..."

# Vercel Deployment (Auto-populated by Vercel in production)
# VERCEL_URL="bukz.vercel.app"

# Check configuration completeness in any environment at: GET /api/v1/health
